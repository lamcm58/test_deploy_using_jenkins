pipeline {
    agent any
    options {
        timestamps()
    }

    environment {
        DEPLOY_ENV = "develop"
    }

    stages {
        stage('Checkout') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    git branch: 'deve', url: 'https://github.com/lamcm58/test_deploy_using_jenkins.git'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'composer install --no-interaction --prefer-dist --optimize-autoloader'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'php artisan test'
            }
        }

        stage('Deploy with Ansible') {
            steps {
                script {
                    // Alternative: Use inline vault password via stdin
                    withCredentials([
                        string(credentialsId: 'ansible-vault-password', variable: 'VAULT_PASS')
                    ]) {
                        sh '''
                            # Create temporary script that echoes password
                            echo '#!/bin/bash' > /tmp/vault_pass.sh
                            echo "echo '${VAULT_PASS}'" >> /tmp/vault_pass.sh
                            chmod +x /tmp/vault_pass.sh
                            
                            # Run ansible-playbook
                            ansible-playbook -i ansible/inventory ansible/deploy.yml \
                                --vault-password-file /tmp/vault_pass.sh \
                                --extra-vars "env=${DEPLOY_ENV}" \
                                --limit ${DEPLOY_ENV}
                            
                            # Cleanup
                            rm -f /tmp/vault_pass.sh
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Deployment successful!"
        }
        failure {
            echo "❌ Deployment failed!"
        }
    }
}

